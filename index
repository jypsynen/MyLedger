<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Ledger">
<meta name="theme-color" content="#FBF7EF">
<title>The Ledger — Guesthouse Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBF7EF;
    --paper-raised:#FFFEFB;
    --ink:#2B2620;
    --ink-soft:#6B6258;
    --rule:#E3DCC9;
    --rule-strong:#CFC4A8;
    --brass:#C2944A;
    --brass-deep:#9C7530;
    --red:#A1463D;
    --red-bg:#F4E6E2;
    --sage:#5C7A5C;
    --sage-bg:#E8EEE3;
    --shadow: 0 1px 2px rgba(43,38,32,0.06), 0 2px 8px rgba(43,38,32,0.05);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);}
  body{
    font-family:'Inter',-apple-system,sans-serif;
    font-size:15px;
    -webkit-font-smoothing:antialiased;
    padding-bottom:calc(78px + env(safe-area-inset-bottom));
    padding-top:env(safe-area-inset-top);
    min-height:100vh;
    position:relative;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(43,38,32,0.035) 1px, transparent 0);
    background-size: 14px 14px;
  }
  h1,h2,h3{font-family:'Fraunces',serif; margin:0; letter-spacing:-0.01em;}
  .mono{font-family:'JetBrains Mono',monospace;}
  button{font-family:inherit; cursor:pointer;}
  ::selection{background:var(--brass); color:#fff;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky; top:0; z-index:20;
    background:rgba(251,247,239,0.92);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--rule);
    padding:14px 18px 12px;
  }
  .topbar-row{display:flex; align-items:baseline; justify-content:space-between;}
  .brand{display:flex; align-items:baseline; gap:8px;}
  .brand h1{font-size:21px; font-weight:600; font-style:italic;}
  .brand .dot{width:6px;height:6px;border-radius:50%;background:var(--brass);display:inline-block;}
  .month-pill{
    font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600;
    color:var(--brass-deep); background:#fff; border:1px solid var(--rule-strong);
    padding:5px 10px; border-radius:20px; letter-spacing:0.03em; text-transform:uppercase;
    display:flex; align-items:center; gap:6px;
  }
  .month-pill svg{width:11px;height:11px;}

  .cal-toggle-row{display:flex; align-items:center; justify-content:flex-end; gap:8px; margin-top:8px;}
  .cal-toggle-label{font-size:11px; color:var(--ink-soft);}
  .cal-toggle{display:flex; background:#fff; border:1px solid var(--rule-strong); border-radius:20px; padding:2px; gap:2px;}
  .cal-toggle-opt{
    font-family:'JetBrains Mono',monospace; font-size:10.5px; font-weight:700; padding:4px 10px;
    border-radius:18px; border:none; background:none; color:var(--ink-soft);
  }
  .cal-toggle-opt.selected{background:var(--ink); color:var(--paper);}

  /* ---------- Page container ---------- */
  .page{padding:18px; max-width:600px; margin:0 auto;}
  .page-title{font-size:13px; text-transform:uppercase; letter-spacing:0.08em; color:var(--ink-soft); font-weight:600; margin-bottom:10px;}

  /* ---------- Stamp badge (signature element) ---------- */
  .stamp{
    width:42px; height:42px; border-radius:50%;
    border:1.5px dashed var(--brass-deep);
    display:flex; align-items:center; justify-content:center;
    font-family:'JetBrains Mono',monospace; font-weight:700; font-size:12.5px;
    color:var(--brass-deep); flex-shrink:0; background:var(--paper-raised);
    transform:rotate(-3deg);
  }
  .stamp.occupied{border-style:solid; border-color:var(--red); color:var(--red); background:var(--red-bg);}
  .stamp.vacant{border-style:dashed; border-color:var(--sage); color:var(--sage); background:var(--sage-bg);}
  .stamp.sm{width:32px;height:32px;font-size:10.5px;}

  /* ---------- Cards ---------- */
  .card{
    background:var(--paper-raised); border:1px solid var(--rule);
    border-radius:14px; padding:14px; box-shadow:var(--shadow);
  }
  .card + .card{margin-top:10px;}

  /* ---------- Summary strip ---------- */
  .summary-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:16px;}
  .sum-box{background:var(--paper-raised); border:1px solid var(--rule); border-radius:12px; padding:11px 10px; text-align:left;}
  .sum-box .label{font-size:10px; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); font-weight:600;}
  .sum-box .value{font-family:'JetBrains Mono',monospace; font-size:17px; font-weight:700; margin-top:3px;}
  .sum-box.due .value{color:var(--red);}
  .sum-box.collected .value{color:var(--sage);}

  /* ---------- Booking row ---------- */
  .booking{display:flex; gap:11px; align-items:flex-start; padding:11px 0; border-bottom:1px solid var(--rule);}
  .booking:last-child{border-bottom:none;}
  .booking-main{flex:1; min-width:0;}
  .booking-top{display:flex; justify-content:space-between; align-items:baseline; gap:8px;}
  .tenant{font-weight:600; font-size:14.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .rent{font-family:'JetBrains Mono',monospace; font-weight:700; font-size:14.5px; white-space:nowrap;}
  .booking-sub{font-size:12px; color:var(--ink-soft); margin-top:2px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;}
  .tag{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; padding:2px 7px; border-radius:20px;}
  .tag.paid{background:var(--sage-bg); color:var(--sage);}
  .tag.partial{background:#FBF0DD; color:var(--brass-deep);}
  .tag.due{background:var(--red-bg); color:var(--red);}

  /* ---------- Empty state ---------- */
  .empty{text-align:center; padding:50px 20px; color:var(--ink-soft);}
  .empty svg{width:38px;height:38px; opacity:0.35; margin-bottom:10px;}
  .empty .t{font-family:'Fraunces',serif; font-style:italic; font-size:17px; color:var(--ink); margin-bottom:4px;}
  .empty .s{font-size:13px; max-width:260px; margin:0 auto;}

  /* ---------- FAB ---------- */
  .fab{
    position:fixed; right:18px; bottom:calc(92px + env(safe-area-inset-bottom));
    width:54px; height:54px; border-radius:50%; background:var(--ink);
    color:var(--paper); border:none; box-shadow:0 4px 14px rgba(43,38,32,0.3);
    display:flex; align-items:center; justify-content:center; z-index:30;
    transition:transform 0.15s ease;
  }
  .fab:active{transform:scale(0.92);}
  .fab svg{width:24px;height:24px;}

  /* ---------- Tab bar ---------- */
  .tabbar{
    position:fixed; bottom:0; left:0; right:0; z-index:25;
    background:rgba(251,247,239,0.94); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-top:1px solid var(--rule);
    padding:8px 6px calc(8px + env(safe-area-inset-bottom));
    display:flex; justify-content:space-around;
  }
  .tab{
    background:none; border:none; display:flex; flex-direction:column; align-items:center; gap:3px;
    color:var(--ink-soft); padding:4px 4px; flex:1; max-width:74px;
  }
  .tab svg{width:20px;height:20px;}
  .tab span{font-size:9.5px; font-weight:600;}
  .tab.active{color:var(--red);}

  /* ---------- Modal / sheet ---------- */
  .sheet-backdrop{
    position:fixed; inset:0; background:rgba(43,38,32,0.4); z-index:50;
    display:none; align-items:flex-end; justify-content:center;
  }
  .sheet-backdrop.open{display:flex;}
  .sheet{
    background:var(--paper); width:100%; max-width:600px; border-radius:20px 20px 0 0;
    max-height:88vh; overflow-y:auto; padding:18px 18px calc(24px + env(safe-area-inset-bottom));
    animation:slideUp 0.22s ease;
  }
  @keyframes slideUp{from{transform:translateY(100%);} to{transform:translateY(0);}}
  .sheet-handle{width:36px;height:4px;background:var(--rule-strong);border-radius:4px;margin:0 auto 14px;}
  .sheet h2{font-size:19px; font-weight:600; font-style:italic; margin-bottom:14px;}
  .field{margin-bottom:13px;}
  .field label{display:block; font-size:11px; text-transform:uppercase; letter-spacing:0.05em; color:var(--ink-soft); font-weight:600; margin-bottom:6px;}
  .field input, .field select{
    width:100%; padding:11px 12px; border:1px solid var(--rule-strong); border-radius:10px;
    background:#fff; font-size:15px; font-family:inherit; color:var(--ink);
  }
  .field input:focus, .field select:focus{outline:none; border-color:var(--brass);}
  .row2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .room-picker{display:flex; gap:8px; flex-wrap:wrap;}
  .room-opt{
    border:1.5px solid var(--rule-strong); border-radius:10px; padding:8px 12px;
    font-family:'JetBrains Mono',monospace; font-weight:700; font-size:13px; background:#fff; color:var(--ink-soft);
  }
  .room-opt.selected{border-color:var(--red); color:var(--red); background:var(--red-bg);}
  .btn-primary{
    width:100%; padding:14px; border-radius:12px; background:var(--ink); color:var(--paper);
    border:none; font-weight:600; font-size:15px; margin-top:6px;
  }
  .btn-primary:active{opacity:0.85;}
  .btn-row{display:flex; gap:10px; margin-top:14px;}
  .btn-row .btn-primary{margin-top:0;}
  .btn-ghost{
    flex:1; padding:14px; border-radius:12px; background:none; border:1.5px solid var(--rule-strong);
    color:var(--ink-soft); font-weight:600; font-size:14px;
  }
  .status-picker{display:flex; gap:8px;}
  .status-opt{flex:1; padding:9px; border-radius:10px; border:1.5px solid var(--rule-strong); font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; background:#fff; color:var(--ink-soft);}
  .status-opt.selected.paid{border-color:var(--sage); background:var(--sage-bg); color:var(--sage);}
  .status-opt.selected.partial{border-color:var(--brass-deep); background:#FBF0DD; color:var(--brass-deep);}
  .status-opt.selected.due{border-color:var(--red); background:var(--red-bg); color:var(--red);}

  /* ---------- Chart page ---------- */
  .chart-wrap{background:var(--paper-raised); border:1px solid var(--rule); border-radius:14px; padding:16px; margin-bottom:12px;}
  .chart-title{font-size:12px; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); font-weight:600; margin-bottom:12px;}
  .bar-row{display:flex; align-items:center; gap:10px; margin-bottom:9px;}
  .bar-label{width:62px; font-size:11.5px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; flex-shrink:0;}
  .bar-track{flex:1; height:18px; background:var(--rule); border-radius:4px; overflow:hidden; position:relative;}
  .bar-fill{height:100%; background:linear-gradient(90deg, var(--brass), var(--red)); border-radius:4px; transition:width 0.4s ease;}
  .bar-val{width:64px; text-align:right; font-family:'JetBrains Mono',monospace; font-size:11.5px; font-weight:700; flex-shrink:0;}

  .room-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:10px;}
  .room-card{background:var(--paper-raised); border:1px solid var(--rule); border-radius:14px; padding:13px; box-shadow:var(--shadow);}
  .room-card .top{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;}
  .room-card .meta{font-size:11.5px; color:var(--ink-soft); line-height:1.5;}
  .room-card .meta b{color:var(--ink); font-family:'JetBrains Mono',monospace;}

  .section-divider{display:flex; align-items:center; gap:8px; margin:20px 0 12px; color:var(--ink-soft);}
  .section-divider .line{flex:1; height:1px; background:var(--rule);}
  .section-divider span{font-size:11px; text-transform:uppercase; letter-spacing:0.07em; font-weight:600;}

  /* ---------- Expenses ---------- */
  .cat-chip{
    display:inline-flex; align-items:center; font-size:10px; font-weight:700; text-transform:uppercase;
    letter-spacing:0.04em; padding:2px 8px; border-radius:20px; background:#EFE9DA; color:var(--ink-soft);
  }
  .expense-amt{font-family:'JetBrains Mono',monospace; font-weight:700; font-size:14.5px; white-space:nowrap; color:var(--red);}
  .cat-picker{display:flex; gap:8px; flex-wrap:wrap;}
  .cat-opt{
    border:1.5px solid var(--rule-strong); border-radius:10px; padding:8px 12px;
    font-size:12.5px; font-weight:600; background:#fff; color:var(--ink-soft);
  }
  .cat-opt.selected{border-color:var(--brass-deep); color:var(--brass-deep); background:#FBF0DD;}
  .net-box .value{font-size:17px;}
  .net-box.positive .value{color:var(--sage);}
  .net-box.negative .value{color:var(--red);}

  .swipe-hint{font-size:11px; color:var(--ink-soft); text-align:center; margin-top:6px;}

  /* ---------- OTA Sync ---------- */
  .sync-btn{
    width:100%; display:flex; align-items:center; justify-content:center; gap:8px;
    padding:11px; border-radius:12px; border:1.5px dashed var(--rule-strong);
    background:var(--paper-raised); color:var(--ink); font-weight:600; font-size:13.5px;
    margin-bottom:14px;
  }
  .sync-btn svg{width:16px;height:16px;}
  .sync-btn:active{opacity:0.7;}
  .sync-btn .spin{animation:spin 0.9s linear infinite;}
  .sync-room-group{margin-bottom:4px;}
  .sync-room-head{
    display:flex; align-items:center; gap:8px; padding:10px 0 6px;
    font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--ink-soft);
  }
  .sync-item{
    display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--rule);
  }
  .sync-item:last-child{border-bottom:none;}
  .sync-item .info{flex:1; min-width:0;}
  .sync-item .dates{font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:600;}
  .sync-item .src{font-size:11px; color:var(--ink-soft); text-transform:capitalize;}
  .sync-add-btn{
    flex-shrink:0; padding:7px 12px; border-radius:9px; border:1.5px solid var(--sage); background:var(--sage-bg);
    color:var(--sage); font-weight:700; font-size:12px;
  }
  .sync-add-btn.added{border-color:var(--rule-strong); background:transparent; color:var(--ink-soft);}
  .sync-empty{text-align:center; padding:30px 16px; color:var(--ink-soft); font-size:13px;}

  /* ---------- Bill / print ---------- */
  .bill-icon-btn{
    flex-shrink:0; width:34px; height:34px; border-radius:8px; border:1px solid var(--rule-strong);
    background:var(--paper-raised); display:flex; align-items:center; justify-content:center;
    color:var(--ink-soft); align-self:center;
  }
  .bill-icon-btn svg{width:17px;height:17px;}
  .bill-icon-btn:active{background:var(--rule); color:var(--ink);}

  @media print{
    body{ background:#fff !important; padding:0 !important; background-image:none !important; }
    .topbar,.tabbar,.fab,.sheet-backdrop,.toast{ display:none !important; }
    #app{ display:none !important; }
    #bill-print-area{ display:block !important; }
  }
  #bill-print-area{ display:none; }
  .receipt-slot{
    border:1.5px dashed var(--rule-strong); border-radius:12px; background:var(--paper-raised);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:18px 14px; gap:8px; text-align:center;
  }
  .receipt-slot .icon-circle{
    width:38px; height:38px; border-radius:50%; background:#FBF0DD; border:1px solid var(--rule-strong);
    display:flex; align-items:center; justify-content:center;
  }
  .receipt-slot .icon-circle svg{width:18px;height:18px; color:var(--brass-deep);}
  .receipt-slot .hint{font-size:11.5px; color:var(--ink-soft);}
  .receipt-btn-row{display:flex; gap:8px; width:100%; margin-top:4px;}
  .receipt-btn{
    flex:1; padding:9px 8px; border-radius:9px; border:1.5px solid var(--rule-strong);
    background:#fff; font-size:12px; font-weight:700; color:var(--ink);
    display:flex; align-items:center; justify-content:center; gap:5px;
  }
  .receipt-btn svg{width:14px;height:14px;}
  .receipt-btn.scan{border-color:var(--brass-deep); color:var(--brass-deep); background:#FBF0DD;} /* retained for potential future use */
  .receipt-preview{position:relative; border-radius:12px; overflow:hidden; border:1px solid var(--rule);}
  .receipt-preview img{width:100%; max-height:220px; object-fit:cover; display:block;}
  .receipt-preview .remove-receipt{
    position:absolute; top:8px; right:8px; width:28px; height:28px; border-radius:50%;
    background:rgba(43,38,32,0.65); color:#fff; display:flex; align-items:center; justify-content:center; border:none;
  }
  .receipt-preview .remove-receipt svg{width:14px;height:14px;}
  .scan-status{
    display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px;
    background:#FBF0DD; border:1px solid var(--rule-strong); font-size:12.5px; color:var(--brass-deep); font-weight:600;
  }
  .scan-status.error{background:var(--red-bg); color:var(--red); border-color:var(--red);}
  .spinner{
    width:14px; height:14px; border-radius:50%; border:2px solid rgba(156,117,48,0.25); border-top-color:var(--brass-deep);
    animation:spin 0.7s linear infinite; flex-shrink:0;
  }
  @keyframes spin{to{transform:rotate(360deg);}}
  .receipt-thumb-link{font-size:11px; color:var(--brass-deep); text-decoration:underline; font-weight:600;}

  /* ---------- Dual calendar date entry ---------- */
  .date-field-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;}
  .date-field-head label{margin-bottom:0;}
  .cal-mini-toggle{display:flex; background:#fff; border:1px solid var(--rule-strong); border-radius:14px; padding:2px;}
  .cal-mini-opt{font-family:'JetBrains Mono',monospace; font-size:9.5px; font-weight:700; padding:2px 7px; border-radius:12px; border:none; background:none; color:var(--ink-soft);}
  .cal-mini-opt.selected{background:var(--brass-deep); color:#fff;}
  .bs-select-row{display:grid; grid-template-columns:1fr 1.3fr 1fr; gap:6px;}
  .bs-select-row select{padding:10px 6px; font-size:13px;}
  .date-convert-preview{font-size:11px; color:var(--brass-deep); margin-top:5px; font-family:'JetBrains Mono',monospace;}
  .date-convert-preview.invalid{color:var(--red);}

  .toast{
    position:fixed; bottom:calc(100px + env(safe-area-inset-bottom)); left:50%; transform:translateX(-50%);
    background:var(--ink); color:var(--paper); padding:10px 18px; border-radius:30px; font-size:13px; font-weight:600;
    z-index:60; opacity:0; transition:opacity 0.25s, transform 0.25s; pointer-events:none;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(-6px);}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-row">
    <div class="brand"><span class="dot"></span><h1>The Ledger</h1></div>
    <div class="month-pill" id="monthPill">Baisakh 2083</div>
  </div>
  <div class="cal-toggle-row">
    <span class="cal-toggle-label">Dates shown in</span>
    <div class="cal-toggle" id="calToggle">
      <button type="button" class="cal-toggle-opt" data-fmt="AD">A.D.</button>
      <button type="button" class="cal-toggle-opt" data-fmt="BS">B.S.</button>
    </div>
  </div>
</div>

<div id="app" class="page"></div>

<button class="fab" id="fabAdd" aria-label="Add booking">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
</button>

<div class="tabbar">
  <button class="tab active" data-tab="bookings">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z"/><path d="M8 8h6M8 12h8M8 16h5"/></svg>
    <span>Bookings</span>
  </button>
  <button class="tab" data-tab="rooms">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    <span>Rooms</span>
  </button>
  <button class="tab" data-tab="expenses">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4Z"/></svg>
    <span>Expenses</span>
