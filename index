    <div class="row2">
      <div class="field">
        <label>Channel</label>
        <select id="f_channel">
          ${['Direct','Booking','Agoda','Walk-in','Other'].map(c=>`<option ${c===b.channel?'selected':''}>${c}</option>`).join('')}
        </select>
