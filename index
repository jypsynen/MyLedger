/* ============ HELPERS ============ */
function fmt(n){ return Number(n||0).toLocaleString('en-IN'); }
function statusOf(b){
  if(b.collected >= b.base && b.base>0) return "paid";
  if(b.collected > 0) return "partial";
  return "due";
}
function daysOf(b){
  if(!b.checkIn || !b.checkOut) return "—";
  const adIn = toTrueAdIso(b.checkIn, b.cal);
  const adOut = toTrueAdIso(b.checkOut, b.cal);
  if(!adIn || !adOut) return "—";
  const a = new Date(adIn+'T00:00:00Z'), c = new Date(adOut+'T00:00:00Z');
  const diff = Math.round((c-a)/(1000*60*60*24));
  return diff>0 ? diff : "—";
}
function dDate(s, cal){
  return displayDate(s, cal);
}
function monthBookings(mi){ return bookings.filter(b=>b.month===mi); }
function monthTotals(mi){
  const list = monthBookings(mi);
  const collected = list.reduce((s,b)=>s+Number(b.collected||0),0);
  const due = list.reduce((s,b)=>s+Math.max(0,Number(b.base||0)-Number(b.collected||0)),0);
  const expected = list.reduce((s,b)=>s+Number(b.base||0),0);
  return {collected, due, expected, count:list.length};
}
function monthExpenses(mi){ return expenses.filter(e=>e.month===mi); }
function monthExpenseTotal(mi){
  return monthExpenses(mi).reduce((s,e)=>s+Number(e.amount||0),0);
}
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 1700);
}

