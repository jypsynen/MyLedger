function loadIgnoredUids(){
  try{ return JSON.parse(localStorage.getItem(SYNC_IGNORED_KEY)) || []; }
  catch(e){ return []; }
}
function saveIgnoredUids(arr){ localStorage.setItem(SYNC_IGNORED_KEY, JSON.stringify(arr)); }

// A booking already exists if any saved booking shares the same room + checkIn (after
// converting both to true AD) — this is how we avoid re-suggesting something already added.
function isAlreadyTracked(room, checkInAdIso){
  return bookings.some(b=>{
    if(b.room !== room) return false;
    const existingAd = toTrueAdIso(b.checkIn, b.cal);
    return existingAd === checkInAdIso;
  });
}

async function runSync(){
  const btn = document.getElementById('syncBtn');
  if(!btn) return;
  const originalHtml = btn.innerHTML;
  btn.innerHTML = `<svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 4v6h-6"/></svg> Checking Booking.com & Agoda…`;
  btn.disabled = true;

  try{
    const resp = await fetch(SYNC_WORKER_URL, { cache: 'no-store' });
    if(!resp.ok) throw new Error('HTTP ' + resp.status);
    const data = await resp.json();
    const ignored = loadIgnoredUids();

    // Flatten into a single list of new, not-yet-tracked, not-ignored bookings
    const found = [];
    (data.rooms || []).forEach(r=>{
      (r.bookings || []).forEach(b=>{
        if(ignored.includes(b.uid)) return;
        if(isAlreadyTracked(r.room, b.checkIn)) return;
        found.push({ room: r.room, checkIn: b.checkIn, checkOut: b.checkOut, source: b.source, uid: b.uid });
      });
    });
    // Sort by check-in date, soonest first
    found.sort((a,b)=>a.checkIn.localeCompare(b.checkIn));

    renderSyncResults(found, data.generatedAt);
  }catch(err){
    toast("Couldn't reach the sync service — check your connection");
  }finally{
    btn.innerHTML = originalHtml;
    btn.disabled = false;
  }
}

function renderSyncResults(found, generatedAt){
  const byRoom = {};
  found.forEach(f=>{
    if(!byRoom[f.room]) byRoom[f.room] = [];
    byRoom[f.room].push(f);
  });
  const roomKeys = Object.keys(byRoom).sort();

  let body;
  if(found.length === 0){
    body = `<div class="sync-empty">No new external bookings found.<br>Everything's already up to date.</div>`;
  } else {
    body = roomKeys.map(room=>{
      const items = byRoom[room].map(f=>`
        <div class="sync-item" data-uid="${esc(f.uid)}">
          <div class="info">
            <div class="dates">${dDate(f.checkIn,'AD')} → ${dDate(f.checkOut,'AD')}</div>
            <div class="src">via ${esc(f.source)}</div>
          </div>
          <button type="button" class="sync-add-btn" onclick="addFromSync('${esc(f.room)}','${esc(f.checkIn)}','${esc(f.checkOut)}','${esc(f.source)}','${esc(f.uid)}', this)">+ Add</button>
        </div>`).join('');
      return `<div class="sync-room-group"><div class="sync-room-head">Room ${esc(room)}</div>${items}</div>`;
    }).join('');
  }

  const html = `
    <div class="sheet-handle"></div>
    <h2>External bookings</h2>
    <p style="font-size:12px; color:var(--ink-soft); margin:-8px 0 14px;">
      Dates only — Booking.com and Agoda don't share guest name or price. Add each one, then fill those in.
    </p>
    ${body}
    <button type="button" class="btn-primary" id="closeSyncBtn" style="margin-top:16px;">Done</button>
  `;
  document.getElementById('sheet').innerHTML = html;
  document.getElementById('sheetBackdrop').classList.add('open');
  document.getElementById('closeSyncBtn').addEventListener('click', closeSheet);
}

// Called when the person taps "+ Add" on a synced booking — opens the normal
// booking form pre-filled with room + dates (in AD, since that's what the feed gives us),
// so they just need to add the guest name, rent, and payment status themselves.
function addFromSync(room, checkIn, checkOut, source, uid, btnEl){
  closeSheet();
  editingId = null;
  renderSheet({
    room, name: '', checkIn, checkOut, cal: 'AD',
    base:'', collected:'', status:'due', channel: source==='booking.com' ? 'Booking' : 'Agoda',
    pay:'Cash', month: state.month
  });
  // Mark this uid as handled so it won't show again even if they cancel without saving;
  // they can always re-sync to bring it back if truly needed.
  const ignored = loadIgnoredUids();
  if(!ignored.includes(uid)){ ignored.push(uid); saveIgnoredUids(ignored); }
}

document.getElementById('fabAdd').addEventListener('click', openAdd);

/* ============ EXPENSE ADD / EDIT SHEET ============ */
function openAddExpense(){
  editingExpenseId = null;
  renderExpenseSheet({amount:'', category:EXPENSE_CATEGORIES[0], vendor:'', paidBy:'', method:'Cash', month:state.month, note:''});
}
function openEditExpense(id){
  editingExpenseId = id;
  const e = expenses.find(x=>x.id===id);
  if(e) renderExpenseSheet(e);
}

function renderExpenseSheet(e){
  const isEdit = !!editingExpenseId;
  const hasReceipt = !!e.receipt;
  const html = `
    <div class="sheet-handle"></div>
    <h2>${isEdit ? 'Edit expense' : 'New expense'}</h2>

    <div class="field">
      <label>Receipt</label>
      <div id="receiptArea">
        ${hasReceipt ? `
          <div class="receipt-preview" id="receiptPreview">
            <img src="${e.receipt}" alt="Receipt photo">
            <button type="button" class="remove-receipt" id="removeReceiptBtn" aria-label="Remove receipt">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
        ` : `
          <div class="receipt-slot" id="receiptSlot">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h2l1.5-2h9L18 7h2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/></svg>
            </div>
            <div class="hint">Snap the receipt to keep a digital copy</div>
            <div class="receipt-btn-row">
              <button type="button" class="receipt-btn" id="attachReceiptBtn" style="flex:1;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h2l1.5-2h9L18 7h2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/></svg>
                Add receipt photo
              </button>
            </div>
          </div>
        `}
        <input type="file" id="receiptFileAttach" accept="image/*" capture="environment" style="display:none;">
      </div>
      <div id="scanStatusArea"></div>
    </div>

    <div class="field">
      <label>Category</label>
      <div class="cat-picker" id="catPicker">
        ${EXPENSE_CATEGORIES.map(c=>`<button type="button" class="cat-opt ${c===e.category?'selected':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join('')}
      </div>
    </div>

    <div class="row2">
      <div class="field">
        <label>Amount (₨)</label>
        <input type="number" id="ex_amount" value="${e.amount||''}" placeholder="0" inputmode="numeric">
      </div>
      <div class="field">
        <label>Month</label>
        <select id="ex_month">
          ${NEPALI_MONTHS.map((m,i)=>`<option value="${i}" ${i===e.month?'selected':''}>${m}</option>`).join('')}
        </select>
      </div>
    </div>

    <div class="field">
      <label>Vendor / paid to</label>
      <input type="text" id="ex_vendor" value="${esc(e.vendor)}" placeholder="e.g. local hardware store">
    </div>

    <div class="row2">
      <div class="field">
        <label>Paid by</label>
        <input type="text" id="ex_paidby" value="${esc(e.paidBy)}" placeholder="e.g. Sarina, Jeewan">
      </div>
      <div class="field">
        <label>Payment method</label>
        <select id="ex_method">
          ${['Cash','Esewa','Phonepay','Nabil Bank','Atm','Other'].map(c=>`<option ${c===e.method?'selected':''}>${c}</option>`).join('')}
        </select>
      </div>
    </div>

    <div class="field">
      <label>Note</label>
      <input type="text" id="ex_note" value="${esc(e.note)}" placeholder="optional detail">
    </div>

    <div class="btn-row">
      ${isEdit ? `<button type="button" class="btn-ghost" id="deleteExBtn" style="color:var(--red); border-color:var(--red);">Delete</button>` : ''}
      <button type="button" class="btn-primary" id="saveExBtn">${isEdit?'Save changes':'Add expense'}</button>
    </div>
  `;
  document.getElementById('sheet').innerHTML = html;
  document.getElementById('sheetBackdrop').classList.add('open');

  let selectedCat = e.category;
  let receiptData = e.receipt || null;
  document.querySelectorAll('#catPicker .cat-opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      selectedCat = el.dataset.cat;
      document.querySelectorAll('#catPicker .cat-opt').forEach(x=>x.classList.remove('selected'));
      el.classList.add('selected');
    });
  });

  /* ---- Receipt capture wiring ---- */
  function setScanStatus(html){
    document.getElementById('scanStatusArea').innerHTML = html;
  }
  function showReceiptPreview(dataUrl){
    receiptData = dataUrl;
    document.getElementById('receiptArea').innerHTML = `
      <div class="receipt-preview" id="receiptPreview">
        <img src="${dataUrl}" alt="Receipt photo">
        <button type="button" class="remove-receipt" id="removeReceiptBtn" aria-label="Remove receipt">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <input type="file" id="receiptFileAttach" accept="image/*" capture="environment" style="display:none;">
    `;
    wireRemoveReceipt();
  }
  function showReceiptSlot(){
    receiptData = null;
    document.getElementById('receiptArea').innerHTML = `
      <div class="receipt-slot" id="receiptSlot">
        <div class="icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h2l1.5-2h9L18 7h2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/></svg>
        </div>
        <div class="hint">Snap the receipt to keep a digital copy</div>
        <div class="receipt-btn-row">
          <button type="button" class="receipt-btn" id="attachReceiptBtn" style="flex:1;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h2l1.5-2h9L18 7h2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/></svg>
            Add receipt photo
          </button>
        </div>
      </div>
      <input type="file" id="receiptFileAttach" accept="image/*" capture="environment" style="display:none;">
    `;
    wireSlotButtons();
  }

  // Resize/compress image client-side so localStorage doesn't bloat
  function resizeImage(file, maxDim){
    return new Promise((resolve, reject)=>{
      const reader = new FileReader();
      reader.onload = ()=>{
        const img = new Image();
        img.onload = ()=>{
          let w = img.width, h = img.height;
          if(w > h && w > maxDim){ h = Math.round(h * maxDim/w); w = maxDim; }
          else if(h > maxDim){ w = Math.round(w * maxDim/h); h = maxDim; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/jpeg', 0.72));
        };
        img.onerror = reject;
        img.src = reader.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function handleAttachOnly(file){
    if(!file) return;
    try{
      const dataUrl = await resizeImage(file, 1400);
      showReceiptPreview(dataUrl);
      setScanStatus('');
    }catch(err){
      toast('Could not load that photo');
    }
  }

  function wireSlotButtons(){
    const attachBtn = document.getElementById('attachReceiptBtn');
    const fileAttach = document.getElementById('receiptFileAttach');
    if(attachBtn) attachBtn.addEventListener('click', ()=>fileAttach.click());
    if(fileAttach) fileAttach.addEventListener('change', (ev)=>handleAttachOnly(ev.target.files[0]));
  }
  function wireRemoveReceipt(){
    const removeBtn = document.getElementById('removeReceiptBtn');
    if(removeBtn) removeBtn.addEventListener('click', ()=>{ showReceiptSlot(); setScanStatus(''); });
  }
  if(hasReceipt) wireRemoveReceipt();
  else wireSlotButtons();

  document.getElementById('saveExBtn').addEventListener('click', ()=>{
    const amount = Number(document.getElementById('ex_amount').value||0);
    const vendor = document.getElementById('ex_vendor').value.trim();
    const paidBy = document.getElementById('ex_paidby').value.trim();
    const method = document.getElementById('ex_method').value;
    const month = Number(document.getElementById('ex_month').value);
    const note = document.getElementById('ex_note').value.trim();

    if(!amount){ toast('Add an amount'); return; }

    const rec = {
      id: editingExpenseId || Math.random().toString(36).slice(2,9),
      amount, category: selectedCat, vendor, paidBy, method, month, note,
      receipt: receiptData || null
    };

    if(editingExpenseId){
      const idx = expenses.findIndex(x=>x.id===editingExpenseId);
      expenses[idx] = rec;
      toast('Expense updated');
    } else {
      expenses.push(rec);
      toast('Expense added');
    }
    try{
      saveExpenses();
    }catch(err){
      toast('Saved, but receipt image was too large to store');
      rec.receipt = null;
      if(editingExpenseId){ expenses[expenses.findIndex(x=>x.id===editingExpenseId)] = rec; }
      else { expenses[expenses.length-1] = rec; }
      saveExpenses();
    }
    closeSheet();
    switchTab(state.tab);
  });

  const delExBtn = document.getElementById('deleteExBtn');
  if(delExBtn){
    delExBtn.addEventListener('click', ()=>{
      expenses = expenses.filter(x=>x.id!==editingExpenseId);
      saveExpenses();
      closeSheet();
      toast('Expense deleted');
      switchTab(state.tab);
    });
  }
}

/* ============ INIT ============ */
document.getElementById('monthPill').textContent = `${NEPALI_MONTHS[state.month]} 2083`;

function refreshCalToggleUI(){
  document.querySelectorAll('#calToggle .cal-toggle-opt').forEach(el=>{
    el.classList.toggle('selected', el.dataset.fmt === state.dateFormat);
  });
}
document.querySelectorAll('#calToggle .cal-toggle-opt').forEach(el=>{
  el.addEventListener('click', ()=>{
    state.dateFormat = el.dataset.fmt;
    saveState();
    refreshCalToggleUI();
    switchTab(state.tab);
  });
});
refreshCalToggleUI();

// On startup: check if IndexedDB has data that localStorage is missing, and restore silently
idbRestoreIfNeeded().then(()=>{
  switchTab(state.tab || 'bookings');
});
// On first load, seed IDB with whatever data we have right now
idbSaveAll();
</script>
