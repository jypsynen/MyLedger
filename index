/* ============ EXPORT / IMPORT ============ */
function exportData(){
  const payload = {
    exportedAt: new Date().toISOString(),
    version: 1,
    bookings: bookings,
    expenses: expenses,
    state: { month: state.month, dateFormat: state.dateFormat }
  };
  const json = JSON.stringify(payload, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const dateStr = new Date().toISOString().slice(0,10);
  a.href = url;
  a.download = `ledger-backup-${dateStr}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  localStorage.setItem('ledger_last_export', new Date().toISOString());
  toast('Backup saved to Files');
  setTimeout(()=>switchTab('months'), 800);
}

function importData(input){
  const file = input.files[0];
  if(!file){ return; }
  const reader = new FileReader();
  reader.onload = (e)=>{
    try{
      const data = JSON.parse(e.target.result);
      if(!data.bookings || !Array.isArray(data.bookings)){
        toast('Invalid backup file — not imported');
        return;
      }
      // Store pending import in a safe variable, not inline JSON
      window._pendingImport = data;
      const bCount = data.bookings.length;
      const eCount = (data.expenses||[]).length;
      const exportDate = data.exportedAt ? new Date(data.exportedAt).toLocaleDateString('en-GB') : 'unknown date';

      document.getElementById('sheet').innerHTML = `
        <div class="sheet-handle"></div>
        <h2>Restore from backup?</h2>
        <p style="font-size:13.5px; line-height:1.6; color:var(--ink); margin-bottom:16px;">
          This backup from <strong>${esc(exportDate)}</strong> contains <strong>${bCount} bookings</strong> and <strong>${eCount} expenses</strong>.
          <br><br>
          Importing will <span style="color:var(--red); font-weight:600;">replace all your current data</span> with this backup. This cannot be undone.
        </p>
        <div class="btn-row">
          <button type="button" class="btn-ghost" onclick="closeSheet()">Cancel</button>
          <button type="button" class="btn-primary" style="background:var(--red);" onclick="confirmImport()">Yes, restore</button>
        </div>
      `;
      document.getElementById('sheetBackdrop').classList.add('open');
    } catch(err){
      toast('Could not read that file — make sure it\'s a Ledger backup');
    }
    input.value = '';
  };
  reader.readAsText(file);
}

function confirmImport(){
  try{
    const data = window._pendingImport;
    if(!data) { toast('No backup to restore'); return; }
    bookings = data.bookings || [];
    expenses = data.expenses || [];
    if(data.state){
      state.dateFormat = data.state.dateFormat || 'AD';
      state.month = data.state.month || 0;
    }
    saveBookings();
    saveExpenses();
    saveState();
    refreshCalToggleUI();
    window._pendingImport = null;
    closeSheet();
    toast('Backup restored successfully');
    switchTab('bookings');
  } catch(err){
    toast('Restore failed — data unchanged');
    closeSheet();
  }
}

