    <div class="field">
      <label>Payment status</label>
      <div class="status-picker" id="statusPicker">
        <button type="button" class="status-opt paid ${statusOf(b)==='paid'?'selected':''}" data-st="paid">Paid</button>
        <button type="button" class="status-opt partial ${statusOf(b)==='partial'?'selected':''}" data-st="partial">Partial</button>
        <button type="button" class="status-opt due ${statusOf(b)==='due'?'selected':''}" data-st="due">Due</button>
