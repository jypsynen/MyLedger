      <div class="field">
        <label>Payment method</label>
        <select id="f_pay">
          ${['Cash','Esewa','Phonepay','Nabil Bank','Atm','Agoda','Other'].map(c=>`<option ${c===b.pay?'selected':''}>${c}</option>`).join('')}
        </select>
      </div>
    </div>

    <div class="field">
      <label>Month</label>
      <select id="f_month">
        ${NEPALI_MONTHS.map((m,i)=>`<option value="${i}" ${i===b.month?'selected':''}>${m}</option>`).join('')}
      </select>
    </div>

    <div class="btn-row">
      ${isEdit ? `<button type="button" class="btn-ghost" id="deleteBtn" style="color:var(--red); border-color:var(--red);">Delete</button>` : ''}
      <button type="button" class="btn-primary" id="saveBtn">${isEdit?'Save changes':'Add booking'}</button>
    </div>
  `;
  document.getElementById('sheet').innerHTML = html;
  document.getElementById('sheetBackdrop').classList.add('open');

  /* ---- Dual A.D./B.S. date entry widget ---- */
  // Each booking stores ONE calendar tag (b.cal) shared by both dates, since in
  // practice a person enters both check-in/out in the same calendar in one sitting.
  let entryCal = b.cal || 'AD';
  const dateState = { checkIn: b.checkIn || '', checkOut: b.checkOut || '' };

  function bsPartsFromAdIso(adIso){
    if(!adIso) return null;
    const bs = adToBs(adIso);
    return bs;
  }
  function buildYearOptions(centerYear){
    const opts = [];
    for(let y=BS_MIN_YEAR; y<=BS_MAX_YEAR; y++) opts.push(y);
    return opts;
  }
  function renderDateInput(key, areaId, previewId){
    const area = document.getElementById(areaId);
    const currentVal = dateState[key]; // stored in entryCal's terms
    if(entryCal === 'AD'){
      area.innerHTML = `<input type="date" class="dateInput" data-key="${key}" value="${currentVal||''}">`;
      const inp = area.querySelector('.dateInput');
      inp.addEventListener('change', ()=>{
        dateState[key] = inp.value;
        updatePreview(key, previewId);
      });
    } else {
      // BS mode: year/month/day selects
      let bsParts = null;
      if(currentVal){
        const [yy,mm,dd] = currentVal.split('-').map(Number);
        bsParts = {year:yy, month:mm, day:dd};
      }
      const todayBs = adToBs(new Date().toISOString().slice(0,10)) || {year:2083,month:1,day:1};
      const yr = bsParts ? bsParts.year : todayBs.year;
      const mo = bsParts ? bsParts.month : todayBs.month;
      const dimArr = DAYS_IN_MONTH_BS[yr] || DAYS_IN_MONTH_BS[todayBs.year];
      const dayCount = dimArr ? dimArr[mo-1] : 30;
      const dy = bsParts ? Math.min(bsParts.day, dayCount) : todayBs.day;

      area.innerHTML = `
        <div class="bs-select-row">
          <select class="bsYear" data-key="${key}">
            ${buildYearOptions().map(y=>`<option value="${y}" ${y===yr?'selected':''}>${y}</option>`).join('')}
          </select>
          <select class="bsMonth" data-key="${key}">
            ${NEPALI_MONTHS.map((m,i)=>`<option value="${i+1}" ${i+1===mo?'selected':''}>${m}</option>`).join('')}
          </select>
          <select class="bsDay" data-key="${key}">
            ${Array.from({length:dayCount},(_,i)=>i+1).map(d=>`<option value="${d}" ${d===dy?'selected':''}>${d}</option>`).join('')}
          </select>
        </div>`;
      function syncFromSelects(){
        const yEl = area.querySelector('.bsYear'), mEl = area.querySelector('.bsMonth'), dEl = area.querySelector('.bsDay');
        const y = Number(yEl.value), m = Number(mEl.value);
        const dim = (DAYS_IN_MONTH_BS[y]||[])[m-1] || 30;
        // rebuild day options if month/year changed and day count differs
        const currentDayOptCount = dEl.options.length;
        if(currentDayOptCount !== dim){
          const keepDay = Math.min(Number(dEl.value)||1, dim);
          dEl.innerHTML = Array.from({length:dim},(_,i)=>i+1).map(d=>`<option value="${d}" ${d===keepDay?'selected':''}>${d}</option>`).join('');
        }
        const d = Number(dEl.value);
        dateState[key] = `${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        updatePreview(key, previewId);
      }
      area.querySelectorAll('select').forEach(sel=>sel.addEventListener('change', syncFromSelects));
      // ensure dateState has an initial value even before user touches selects
      if(!currentVal) syncFromSelects();
    }
    updatePreview(key, previewId);
  }
  function updatePreview(key, previewId){
    const el = document.getElementById(previewId);
    const val = dateState[key];
    if(!val){ el.textContent=''; return; }
    if(entryCal === 'AD'){
      const bsIso = adIsoToBsIso(val);
      if(!bsIso){ el.textContent = 'Outside convertible range (1913–2034 AD)'; el.classList.add('invalid'); return; }
      const [y,m,d] = bsIso.split('-');
      el.classList.remove('invalid');
      el.textContent = `= ${d} ${NEPALI_MONTHS[Number(m)-1]} ${y} B.S.`;
    } else {
      const [y,m,d] = val.split('-').map(Number);
      const adIso = bsToAdIso(y,m,d);
      if(!adIso){ el.textContent = 'Invalid B.S. date'; el.classList.add('invalid'); return; }
      const [ay,am,ad] = adIso.split('-');
      el.classList.remove('invalid');
      const monthNamesAd = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      el.textContent = `= ${ad} ${monthNamesAd[Number(am)-1]} ${ay} A.D.`;
    }
  }
  function refreshCalMiniToggles(){
    document.querySelectorAll('#calToggleIn .cal-mini-opt, #calToggleOut .cal-mini-opt').forEach(el=>{
      el.classList.toggle('selected', el.dataset.cal === entryCal);
    });
  }
  function rerenderBothDateInputs(){
    renderDateInput('checkIn', 'dateAreaIn', 'previewIn');
    renderDateInput('checkOut', 'dateAreaOut', 'previewOut');
  }
  function switchEntryCal(newCal){
    if(newCal === entryCal) return;
    // convert currently-held values into the new calendar so nothing is lost
    ['checkIn','checkOut'].forEach(key=>{
      const val = dateState[key];
      if(!val) return;
      if(entryCal === 'AD' && newCal === 'BS'){
        const bsIso = adIsoToBsIso(val);
        if(bsIso) dateState[key] = bsIso;
      } else if(entryCal === 'BS' && newCal === 'AD'){
        const [y,m,d] = val.split('-').map(Number);
        const adIso = bsToAdIso(y,m,d);
        if(adIso) dateState[key] = adIso;
      }
    });
    entryCal = newCal;
    refreshCalMiniToggles();
    rerenderBothDateInputs();
  }
  document.querySelectorAll('#calToggleIn .cal-mini-opt, #calToggleOut .cal-mini-opt').forEach(el=>{
    el.addEventListener('click', ()=>switchEntryCal(el.dataset.cal));
  });
  refreshCalMiniToggles();
  rerenderBothDateInputs();

  let selectedRoom = b.room;
  let selectedStatus = statusOf(b);
  document.querySelectorAll('#roomPicker .room-opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      selectedRoom = el.dataset.room;
      document.querySelectorAll('#roomPicker .room-opt').forEach(x=>x.classList.remove('selected'));
      el.classList.add('selected');
    });
  });
  document.querySelectorAll('#statusPicker .status-opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      selectedStatus = el.dataset.st;
      document.querySelectorAll('#statusPicker .status-opt').forEach(x=>x.classList.remove('selected'));
      el.classList.add('selected');
      // auto-fill collected based on status choice if collected is empty/zero
      const baseVal = Number(document.getElementById('f_base').value||0);
      const collEl = document.getElementById('f_collected');
      if(selectedStatus==='paid') collEl.value = baseVal||collEl.value;
      if(selectedStatus==='due') collEl.value = 0;
    });
  });

  document.getElementById('saveBtn').addEventListener('click', ()=>{
    const name = document.getElementById('f_name').value.trim();
    const checkIn = dateState.checkIn;
    const checkOut = dateState.checkOut;
    const base = Number(document.getElementById('f_base').value||0);
    let collected = Number(document.getElementById('f_collected').value||0);
    const channel = document.getElementById('f_channel').value;
    const pay = document.getElementById('f_pay').value;
    const month = Number(document.getElementById('f_month').value);

    if(!name){ toast('Add a guest name'); return; }
    if(!checkIn){ toast('Add a check-in date'); return; }

    const rec = {
      id: editingId || Math.random().toString(36).slice(2,9),
      room: selectedRoom, name, checkIn, checkOut, cal: entryCal, base, collected,
      channel, pay, month
    };

    if(editingId){
      const idx = bookings.findIndex(x=>x.id===editingId);
      bookings[idx] = rec;
      toast('Booking updated');
    } else {
      bookings.push(rec);
      toast('Booking added');
    }
    saveBookings();
    closeSheet();
    switchTab(state.tab);
  });

  const delBtn = document.getElementById('deleteBtn');
  if(delBtn){
    delBtn.addEventListener('click', ()=>{
      bookings = bookings.filter(x=>x.id!==editingId);
      saveBookings();
      closeSheet();
      toast('Booking deleted');
      switchTab(state.tab);
    });
  }
}

