/* ============ INDEXED DB — redundant storage layer ============
   Acts as a second, independent copy of all data. IndexedDB is
   separate from localStorage and won't be cleared at the same time,
   giving you two independent local copies on the device at all times.
   All IDB operations are async/fire-and-forget — they never block the UI. */
const IDB_NAME = 'LedgerDB_v1';
const IDB_STORE = 'snapshots';
let _idb = null;

function idbOpen(){
  return new Promise((resolve, reject)=>{
    if(_idb){ resolve(_idb); return; }
    const req = indexedDB.open(IDB_NAME, 1);
    req.onupgradeneeded = e=>{
      e.target.result.createObjectStore(IDB_STORE);
    };
    req.onsuccess = e=>{ _idb = e.target.result; resolve(_idb); };
    req.onerror = ()=>reject(req.error);
  });
}
function idbSaveAll(){
  // Fire-and-forget: save all data to IDB without blocking anything
  idbOpen().then(db=>{
    const tx = db.transaction(IDB_STORE, 'readwrite');
    const st = tx.objectStore(IDB_STORE);
    const snapshot = {
      savedAt: new Date().toISOString(),
      bookings, expenses,
      state: { month: state.month, dateFormat: state.dateFormat }
    };
    st.put(JSON.stringify(snapshot), 'latest');
  }).catch(()=>{}); // silently ignore IDB errors — localStorage is still the primary
}
function idbLoad(){
  // Returns a promise resolving to the stored snapshot, or null
  return idbOpen().then(db=>{
    return new Promise((resolve)=>{
      const tx = db.transaction(IDB_STORE, 'readonly');
      const req = tx.objectStore(IDB_STORE).get('latest');
      req.onsuccess = ()=>{
        try{ resolve(req.result ? JSON.parse(req.result) : null); }
        catch(e){ resolve(null); }
      };
      req.onerror = ()=>resolve(null);
    });
  }).catch(()=>null);
}
async function idbRestoreIfNeeded(){
  // On startup: if localStorage is empty/missing but IDB has data, restore from IDB.
  // This covers the case where Safari clears localStorage but not IDB.
  const lsBookings = localStorage.getItem(STORE_KEY);
  if(lsBookings && JSON.parse(lsBookings).length > 0) return; // localStorage has data, no need
  const snapshot = await idbLoad();
  if(!snapshot || !snapshot.bookings || snapshot.bookings.length === 0) return;
  // IDB has data but localStorage is empty — restore silently
  localStorage.setItem(STORE_KEY, JSON.stringify(snapshot.bookings));
  localStorage.setItem(EXPENSE_KEY, JSON.stringify(snapshot.expenses || []));
  if(snapshot.state) localStorage.setItem(STATE_KEY, JSON.stringify(snapshot.state));
  // Reload globals from the now-restored localStorage
