const BS_EPOCH_YEAR = 1970;
const BS_EPOCH_AD_MS = Date.UTC(1913, 3, 13); // 13 April 1913 = 1 Baisakh 1970 BS
const BS_MIN_YEAR = 1970, BS_MAX_YEAR = 2089; // last year with full 12-month data available

function bsDaysInMonth(year, month){
  const arr = DAYS_IN_MONTH_BS[year];
  return arr ? arr[month-1] : null;
}
// True Gregorian (AD) ISO date -> {year,month,day} in Bikram Sambat
function adToBs(adIso){
  const target = Date.UTC(...adIso.split('-').map((v,i)=> i===1 ? Number(v)-1 : Number(v)));
  let days = Math.round((target - BS_EPOCH_AD_MS) / 86400000);
  if(days < 0) return null;
  let year = BS_EPOCH_YEAR;
  while(year <= BS_MAX_YEAR){
    const monthsArr = DAYS_IN_MONTH_BS[year];
    if(!monthsArr) return null;
    for(let m=0;m<12;m++){
      const dim = monthsArr[m];
      if(days < dim) return {year, month:m+1, day:days+1};
      days -= dim;
    }
    year++;
  }
  return null;
}
// Bikram Sambat {year,month,day} -> true Gregorian (AD) ISO date string
function bsToAdIso(year, month, day){
  if(year < BS_MIN_YEAR || year > BS_MAX_YEAR) return null;
  const monthsArr = DAYS_IN_MONTH_BS[year];
  if(!monthsArr || month<1 || month>12 || day<1 || day>monthsArr[month-1]) return null;
  let totalDays = 0;
  for(let y=BS_EPOCH_YEAR; y<year; y++){
    const arr = DAYS_IN_MONTH_BS[y];
    if(!arr) return null;
    totalDays += arr.reduce((a,b)=>a+b,0);
  }
  for(let m=0; m<month-1; m++) totalDays += monthsArr[m];
  totalDays += (day-1);
  const ms = BS_EPOCH_AD_MS + totalDays*86400000;
  const d = new Date(ms);
  const yy = d.getUTCFullYear(), mm = String(d.getUTCMonth()+1).padStart(2,'0'), dd = String(d.getUTCDate()).padStart(2,'0');
  return `${yy}-${mm}-${dd}`;
}
function bsIsoToAdIso(bsIso){
  if(!bsIso) return null;
  const [y,m,d] = bsIso.split('-').map(Number);
  return bsToAdIso(y,m,d);
}
function adIsoToBsIso(adIso){
  if(!adIso) return null;
  const bs = adToBs(adIso);
  if(!bs) return null;
  return `${bs.year}-${String(bs.month).padStart(2,'0')}-${String(bs.day).padStart(2,'0')}`;
}
// Convert a stored date (which may itself be tagged AD or BS) to a true AD iso string for math
function toTrueAdIso(dateStr, cal){
  if(!dateStr) return null;
  return cal === 'BS' ? bsIsoToAdIso(dateStr) : dateStr;
}
// Format a stored date for DISPLAY in the user's chosen display calendar
function displayDate(dateStr, cal){
  if(!dateStr) return '—';
  const trueAd = toTrueAdIso(dateStr, cal);
  if(!trueAd) return '—';
  if(state.dateFormat === 'BS'){
    const bsIso = adIsoToBsIso(trueAd);
    if(!bsIso) return '—';
    const [y,m,d] = bsIso.split('-');
    return `${d}.${m}.${y} BS`;
  } else {
    const [y,m,d] = trueAd.split('-');
    return `${d}.${m}.${y} AD`;
  }
}

