    <div class="field">
      <div class="date-field-head">
        <label style="margin-bottom:0;">Check-out</label>
        <div class="cal-mini-toggle" id="calToggleOut">
          <button type="button" class="cal-mini-opt" data-cal="AD">A.D.</button>
          <button type="button" class="cal-mini-opt" data-cal="BS">B.S.</button>
        </div>
      </div>
      <div id="dateAreaOut"></div>
      <div class="date-convert-preview" id="previewOut"></div>
    </div>

    <div class="row2">
      <div class="field">
        <label>Base rent (₨)</label>
        <input type="number" id="f_base" value="${b.base||''}" placeholder="0" inputmode="numeric">
      </div>
      <div class="field">
        <label>Collected (₨)</label>
